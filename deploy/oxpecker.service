# Oxpecker systemd unit — bare-metal edge hosts without Docker.
#
# Install:
#   sudo cp deploy/oxpecker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oxpecker
#
# Assumes a pip/uv install into /opt/oxpecker/.venv with the package
# installed (pip install -e /path/to/repo) and config at
# /etc/oxpecker/config.json.

[Unit]
Description=Oxpecker — equipment intelligence HMI
Documentation=file:///opt/oxpecker/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oxpecker
Group=oxpecker
# workspace lives on its own directory so retention-capped snapshots and the
# audit ledgers survive upgrades
Environment=OXPECKER_WORKSPACE=/var/lib/oxpecker
WorkingDirectory=/opt/oxpecker
ExecStart=/opt/oxpecker/.venv/bin/oxpecker web /etc/oxpecker/config.json --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
# hardening defaults for an always-on LAN service
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/oxpecker /etc/oxpecker
PrivateTmp=yes
ProtectHome=yes

# journal is the log story: `journalctl -u oxpecker -f`
[Install]
WantedBy=multi-user.target
